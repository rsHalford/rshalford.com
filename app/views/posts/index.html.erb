<% content_for :title, "Posts" %>

<h1>Posts</h1>

<% if authenticated? %>
  <%= form_with url: posts_path, method: :get, data: { turbo_frame: "posts" } do %>
    <label>
      <%= check_box_tag :hide_drafts,
      "1",
      params[:hide_drafts] == "1",
      onchange: "this.form.requestSubmit()" %>
      Hide draft posts
    </label>
  <% end %>
<% end %>

<%= turbo_frame_tag "posts" do %>
  <%= render partial: "posts", locals: { posts: @posts } %>
<% end %>
